<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later draw their own splash screen from these. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/brand_orange</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_mark</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/brand_orange</item>
        <item name="android:navigationBarColor">@color/brand_orange</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/page_cream</item>
    </style>
</resources>
