<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown from process start until Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/brand_orange</item>
        <item name="android:navigationBarColor">@color/brand_orange</item>
    </style>
    <!-- Behind the Flutter view while the app runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/page_cream</item>
    </style>
</resources>
